# ---- Netlify environment variables (Site settings → Environment variables) ----
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the key exactly as in the service-account JSON, including the \n sequences, inside double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Comma-separated college domains. Must match firestore.rules and the frontend config.
ALLOWED_EMAIL_DOMAINS=sathyabama.ac.in
# The site(s) allowed to call the functions (CORS). Your Vercel URL + local dev.
# Exact site address(es), https://…, no trailing slash, comma-separated. "*" allows every site (safe: every call still needs a Firebase token).
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ---- Frontend (used by `npm run configure`, which writes them into the HTML files) ----
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Your Netlify site + /.netlify/functions  (the pages call the functions directly)
FUNCTIONS_BASE_URL=https://your-site.netlify.app/.netlify/functions
